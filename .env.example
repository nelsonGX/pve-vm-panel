# ── Auth provider switch ──────────────────────────────────────
# discord       → plain Discord OAuth (default)
# friend-group  → Friend Group Auth (Discord-gated, only group members in)
AUTH_MODE=discord

# ── Discord OAuth (used when AUTH_MODE=discord) ────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# ── Friend Group Auth (used when AUTH_MODE=friend-group, + credit payments) ──
# Registered automatically via the friend-group-auth skill (device flow);
# creds land in frontend/.env.local (login) and backend/.env (payments).
# AUTH_CLIENT_SECRET is server-side only — never expose it to the browser.
AUTH_BASE_URL=https://group.nelsongx.com
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Frontend only: must exactly match a registered redirect URI.
AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord
# Backend only: app points granted per 1 credit (1 credit = 1 TWD).
POINTS_PER_CREDIT=100

# ── Internal auth between Next.js ↔ FastAPI ───────────────────
INTERNAL_API_SECRET=          # Shared secret, passed as Bearer token

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=

# ── Proxmox VE ────────────────────────────────────────────────
PVE_HOST=
PVE_NODE=                  # Node name where VMs are provisioned
PVE_TOKEN_ID=   # API token ID
PVE_TOKEN_SECRET=             # API token secret
PVE_VERIFY_SSL=false          # Set true in production with valid cert

# ── VM Templates (one VMID per OS image) ──────────────────────
TEMPLATE_UBUNTU_18=
TEMPLATE_UBUNTU_20=
TEMPLATE_UBUNTU_22=
TEMPLATE_UBUNTU_24=
TEMPLATE_CENTOS_7=
TEMPLATE_CENTOS_8=
TEMPLATE_DEBIAN_11=
TEMPLATE_DEBIAN_12=

# ── VM Provisioning ───────────────────────────────────────────
VM_STORAGE=local-lvm          # Target storage for cloned disks
VM_BRIDGE=vmbr0               # Network bridge
VM_VMID_MIN=100000            # VMID range start (inclusive)
VM_VMID_MAX=101000            # VMID range end (inclusive)

# ── Network / IP Pool ─────────────────────────────────────────
VM_IP_RANGE=10.10.0.0/24      # CIDR; IPs are assigned sequentially
VM_GATEWAY=10.10.0.1
VM_DNS=8.8.8.8

# ── Resource Caps (rentable headroom on the node) ─────────────
# CPU: total cores that can be allocated across all active VMs
RESOURCE_LIMIT_CPU=32
# RAM: total GB
RESOURCE_LIMIT_RAM_GB=128
# Disk: total GB
RESOURCE_LIMIT_DISK_GB=2000

# ── GPU Pool (JSON array of objects) ──────────────────────────
# Each entry needs an id and either pci_id or pci_ids. Short PCI addresses like
# "61:00.0" are normalized to "0000:61:00.0".
# For a single RTX 3090 at lspci address 61:00.0:
RESOURCE_GPU_POOL=[{"id":"RTX3090","pci_id":"61:00.0"}]
# If the GPU has an HDMI/audio function in the same IOMMU group, pass both:
# RESOURCE_GPU_POOL=[{"id":"RTX3090","pci_ids":["61:00.0","61:00.1"],"hostpci_options":"pcie=1,x-vga=1"}]

# ── Point Pricing ─────────────────────────────────────────────
# Points charged per unit per hour
PRICE_CPU_CORE_HOUR=1
PRICE_RAM_GB_HOUR=2
PRICE_DISK_GB_HOUR=0          # Free, or set > 0
PRICE_GPU_HOUR=20

# ── Admin ─────────────────────────────────────────────────────
ADMIN_DISCORD_IDS=123456789,987654321

# ── WireGuard VPN (optional) ──────────────────────────────────
# Set NEED_VPN=true to enable VPN prompts and peer management.
NEED_VPN=false
VPN_SUBNET=10.100.0.0/24          # Address space for VPN clients
VPN_SERVER_ENDPOINT=vpn.example.com:51820  # Public endpoint of proxy server
VPN_SERVER_PUBLIC_KEY=             # wg pubkey of the proxy server (from install.sh)
VPN_DAEMON_SECRET=                 # Shared secret for daemon ↔ panel sync
