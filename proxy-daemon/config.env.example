# ===========================================================================
# pve-vm-panel proxy-daemon configuration
# Copy this file to .env and fill in the values.
# ===========================================================================

# URL of the panel backend API (must be reachable from this server)
PANEL_API_URL=https://your-panel.example.com/api/v1

# Shared secret — must match VPN_DAEMON_SECRET in the panel's .env
DAEMON_SECRET=change-me-to-a-long-random-secret

# WireGuard interface name (default: wg0)
WG_INTERFACE=wg0

# Path where wg0.conf is stored (default: /etc/wireguard/wg0.conf)
WG_CONF_PATH=/etc/wireguard/wg0.conf

# Server's WireGuard private key (generate with: wg genkey)
WG_SERVER_PRIVATE_KEY=

# Server's VPN interface address — must be the first host in VPN_SUBNET (.1)
# e.g. if VPN_SUBNET=10.100.0.0/24, set this to 10.100.0.1/24
WG_ADDRESS=10.100.0.1/24

# Port the WireGuard server listens on (default: 51820)
WG_LISTEN_PORT=51820

# How often (seconds) to poll the panel for peer changes (default: 30)
SYNC_INTERVAL=30

# Optional iptables rules injected into wg0.conf PostUp / PostDown.
# Adjust the network interface name (eth0) and VM subnet to match your setup.
# These enable IP forwarding so VPN clients can reach the private VM network.
WG_POSTUP=iptables -A FORWARD -i wg0 -j ACCEPT; iptables -A FORWARD -o wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE
WG_POSTDOWN=iptables -D FORWARD -i wg0 -j ACCEPT; iptables -D FORWARD -o wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o eth0 -j MASQUERADE
